{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chautauqua",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*"],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chautauqua",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "chautauqua-files"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "local"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "placement": {
    "mode": "smart"
  }
  // DEC-183: DEV_MODE lives in .dev.vars (wrangler dev auto-loads it); production must never set it — it mounts /dev/mailbox.
}
