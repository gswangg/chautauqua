{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chautauqua",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": [],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*"],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chautauqua",
      "database_id": "e497c766-ecdd-4dcb-9acf-240668bb3f28",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "chautauqua-files"
    }
  ],
  "routes": [
    {
      "pattern": "chautauqua.cc",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "de4b864736784b1c8c8e1ae875971c43"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    // Stage-2 sender identity for the Resend adapter (DEC-996); the
    // RESEND_API_KEY is a Worker secret, set at deploy time (never a var).
    "MAIL_FROM_EMAIL": "hello@chautauqua.cc",
    "MAIL_FROM_NAME": "Chautauqua",
    // DEC-812/DEC-252: a scheduled (cron) trigger has no incoming request to
    // sniff an origin from, so resolveBaseUrlForCron requires PUBLIC_BASE_URL
    // to be set explicitly — matches the custom_domain declared in `routes`.
    "PUBLIC_BASE_URL": "https://chautauqua.cc"
  }
  // DEC-183: DEV_MODE lives in .dev.vars (wrangler dev auto-loads it); production must never set it — it mounts /dev/mailbox.
}
