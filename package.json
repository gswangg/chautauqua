{
  "name": "chautauqua",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/ensure-dev-vars.ts",
    "dev": "wrangler dev",
    "dev:app": "vite build --watch --config app/vite.config.ts",
    "build": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json && vite build --config app/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply chautauqua --local",
    "seed": "tsx scripts/seed.ts && wrangler d1 execute chautauqua --local --file=.seed.sql && tsx scripts/seed-r2.ts",
    "perf:seed": "tsx scripts/perf-seed.ts && wrangler d1 execute chautauqua --local --file=.perf-seed.sql",
    "perf:smoke": "tsx scripts/perf-smoke.ts",
    "bundle:check": "tsx scripts/bundle-check.ts",
    "walkthrough": "tsx scripts/walkthrough.ts",
    "gate:render-sweep": "tsx scripts/render-sweep.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.28.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
