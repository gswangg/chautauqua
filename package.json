{
  "name": "chautauqua",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "tsx scripts/ensure-dev-vars.ts && vite build --config app/vite.config.ts",
    "dev": "wrangler dev",
    "dev:app": "vite build --watch --config app/vite.config.ts",
    "build": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json && vite build --config app/vite.config.ts",
    "db:migrate": "wrangler d1 migrations apply chautauqua --local",
    "seed": "tsx scripts/seed.ts && wrangler d1 execute chautauqua --local --file=.seed.sql && tsx scripts/seed-r2.ts",
    "perf:seed": "tsx scripts/perf-seed.ts && wrangler d1 execute chautauqua --local --file=.perf-seed.sql",
    "perf:seed:aie": "tsx scripts/perf-seed.ts --profile=aie && wrangler d1 execute chautauqua --local --file=.perf-seed.sql",
    "perf:smoke": "tsx scripts/perf-smoke.ts",
    "perf:smoke:aie": "tsx scripts/perf-smoke.ts --profile=aie",
    "bundle:check": "tsx scripts/bundle-check.ts",
    "walkthrough": "tsx scripts/walkthrough.ts",
    "gate:render-sweep": "tsx scripts/render-sweep.ts",
    "shots:docs": "sh scripts/with-test-lock.sh tsx scripts/docs-shots.ts",
    "gate:scale": "tsx scripts/walkthrough/stress.ts",
    "verification-log:assemble": "tsx scripts/assemble-verification-log.ts",
    "verification-log:check": "tsx scripts/assemble-verification-log.ts --check",
    "verification-log:renumber": "tsx scripts/assemble-verification-log.ts --renumber",
    "exit:predicate": "tsx scripts/exit-predicate.ts",
    "ref-state": "tsx scripts/ref-state.ts",
    "deploy": "wrangler d1 migrations apply chautauqua --remote && wrangler deploy",
    "test": "sh scripts/with-test-lock.sh vitest run",
    "test:fast": "vitest run --config vitest.fast.config.ts",
    "test:full": "sh scripts/with-test-lock.sh vitest run",
    "test:targeted": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.0.0"
  }
}
